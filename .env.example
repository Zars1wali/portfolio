# Copy this file to .env.local for development or .env on the VPS.
# Never commit a file containing real credentials.

# Set by Docker for the production container. Do not use development here on
# the VPS.
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# Public canonical origin. Set this to your deployed HTTPS origin.
# On Vercel this falls back to https://<VERCEL_URL> automatically; on the
# VPS set it explicitly. Local dev without a value uses http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Umami tracking is injected only in production when both are configured.
NEXT_PUBLIC_UMAMI_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
UMAMI_DB_PASSWORD=
UMAMI_APP_SECRET=

# Required to populate the GitHub dashboard. The dashboard shows a fallback
# state when this is omitted.
GITHUB_TOKEN=

# Optional GitHub username. Defaults to Zars1wali when omitted.
GITHUB_USERNAME=Zars1wali
